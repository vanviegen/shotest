{
  "name": "shotest",
  "version": "2.4.0",
  "description": "Playwright + visual diffs",
  "type": "module",
  "main": "./build/index.js",
  "types": "./build/index.d.ts",
  "author": "Frank van Viegen BV",
  "files": [
    "bin",
    "build",
    "build.frontend",
    "src",
    "README.md",
    "skill",
    "screenshot.png"
  ],
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "bun": "./src/index.ts",
      "default": "./build/index.js"
    }
  },
  "bin": {
    "shotest": "./build/cli.js",
    "shotest-playwright": "./bin/shotest-playwright"
  },
  "scripts": {
    "build": "node --experimental-strip-types scripts/build.ts && npm run build:docs",
    "build:docs": "rm -rf skill && mkdir skill && cat skill-header.md README.md > skill/SKILL.md",
    "test": "cd test-project && npm install && npm run test:run",
    "review": "npm run build && SHOTEST_OUTPUT_DIR=test-project/test-results SHOTEST_ACCEPTED_DIR=test-project/test-accepted node build/cli.js review",
    "prepack": "npm run build",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@playwright/test": "^1.62.1",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@types/bun": "^1.4.0",
    "@types/node": "^25.9.5",
    "aberdeen": "^1.22.0",
    "staffa": "0.12.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vite-plugin-singlefile": "^2.3.3"
  }
}
