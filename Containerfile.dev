# Dev container image for ShoTest: Node (for building and running the CLI, the
# review server and the frontend bundle) plus the bits Playwright's own
# installer needs when browsers are pulled in ad hoc.

FROM docker.io/library/node:22-bookworm-slim
ENV DEBIAN_FRONTEND=noninteractive LANG=C.UTF-8
RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates curl git sudo bash procps psmisc ripgrep less nano python3 \
      openssh-client unzip zip xz-utils build-essential pkg-config \
    && rm -rf /var/lib/apt/lists/*
# The docker CLI, talking to the socket TPS serves at $DOCKER_HOST: with it,
# `shotest test` runs in the pinned Playwright image, rendering like the
# baselines, instead of falling back to a native browser.
RUN curl -fsSL https://download.docker.com/linux/static/stable/$(uname -m)/docker-29.9.1.tgz \
      | tar xz -C /usr/local/bin --strip-components=1 docker/docker
# node's image already has a uid 1000 user named 'node'; TPS wants uid 1000 to
# own its home, which it does.
RUN echo 'node ALL=(ALL) NOPASSWD:ALL' >/etc/sudoers.d/node
USER node
WORKDIR /work

# The review app, served by `shotest review`.
EXPOSE 3847
LABEL tps.service.review="npm run review"
# Passes once the tests do and the user has accepted every visual change,
# pointing the user at the review app for as long as it runs.
LABEL tps.test="npm install --no-package-lock --no-audit --no-fund && npm test && /tps/guest-tool request-human-views 3847 && trap '/tps/guest-tool request-human-views' EXIT && npm run review"
# Pushing is the release: GitHub Actions publishes to npm what is pushed.
LABEL tps.deploy="git push origin HEAD:main"
LABEL tps.cache="/home/node/.npm"
